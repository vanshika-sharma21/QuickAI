# Copy this file to .env and fill in your keys.

# Database
DATABASE_URL=

# OpenRouter (used for image edit/background removal/object removal)
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_EDIT_MODEL=openai/gpt-image-1

# Gemini (used for article + blog title + resume review)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Misc (if used elsewhere)
PORT=3000

